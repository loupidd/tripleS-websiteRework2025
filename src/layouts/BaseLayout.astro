---
import BaseHead from '../components/BaseHead.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  image,
  canonicalURL,
  noindex,
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      canonicalURL={canonicalURL}
      noindex={noindex}
    />

    <!-- Tailwind CSS — runtime CDN preserves all original utility classes exactly as authored -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              inter: ['Inter Tight', 'sans-serif'],
              montserrat: ['Montserrat', 'sans-serif'],
              poppins: ['Poppins', 'sans-serif'],
              roboto: ['Roboto', 'sans-serif'],
              quicksand: ['Quicksand', 'sans-serif'],
            },
          },
        },
      };
    </script>

    <!-- Flowbite -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.css" />

    <!-- GSAP + ScrollTrigger -->
    <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

    <!-- Lenis smooth scroll -->
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js"></script>

    <!-- Lottie + Rive (opt-in) -->
    <script is:inline defer src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
    <script is:inline defer src="https://unpkg.com/@rive-app/canvas@latest"></script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/assets/css/style.css" />
  </head>

  <body class={bodyClass}>
    <slot />

    <!-- 1. i18n data — SYNC -->
    <script is:inline src="/assets/js/data/i18n-data.js"></script>

    <!-- 2. Navbar -->
    <script is:inline defer src="/assets/js/core/navbar.js"></script>

    <!-- 3–5. OOP classes -->
    <script is:inline defer src="/assets/js/core/animations.js"></script>
    <script is:inline defer src="/assets/js/core/interactions.js"></script>
    <slot name="page-scripts" />

    <!-- Root bootstrap -->
    <script is:inline defer src="/assets/js/app.js"></script>

    <Analytics />
  </body>
</html>
