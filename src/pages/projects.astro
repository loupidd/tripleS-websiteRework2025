---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Project Portfolio — Sumber Sarana Solusindo"
  description="Portofolio proyek PT. Sumber Sarana Solusindo: gedung komersial, industri, dan hunian di seluruh Indonesia."
>
  <link rel="stylesheet" slot="page-scripts" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
  <script is:inline slot="page-scripts" defer src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
  <script is:inline slot="page-scripts" defer src="/assets/js/sections/ServicesSection.js"></script>

<!-- ═══════════════════════════════════════════
         NAVBAR — same IDs as index.html so navbar.js works
    ═══════════════════════════════════════════ -->
    <nav
      class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 font-poppins bg-white border-b border-gray-100 shadow-sm"
      id="navbar"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          <!-- Logo -->
          <div class="flex items-center group">
            <a
              href="index.html"
              class="flex items-center rounded-xl p-2 hover:bg-black/5 transition-all duration-300"
            >
              <img
                src="/assets/img/LOGO_FINAL1.webp"
                class="h-10 md:h-12 transition-all duration-300 group-hover:scale-110"
                alt="Triple S Logo"
              />
            </a>
          </div>

          <!-- Desktop Nav -->
          <div class="hidden md:flex items-center">
            <div
              class="flex items-center space-x-1 bg-[#0061ae]/8 backdrop-blur-sm rounded-full p-1 border border-[#0061ae]/15"
            >
              <a
                href="index.html#home"
                class="nav-item group relative px-4 py-2.5 text-sm font-medium text-gray-600 hover:text-[#0061ae] transition-all duration-300 rounded-full"
                data-i18n="nav.home"
                ><span class="relative z-10">Home</span>
                <div
                  class="absolute inset-0 bg-[#0061ae]/5 rounded-full opacity-0 group-hover:opacity-100 transition-all"
                ></div
              ></a>
              <a
                href="index.html#projects"
                class="nav-item group relative px-4 py-2.5 text-sm font-semibold text-[#0061ae] transition-all duration-300 rounded-full"
                data-i18n="nav.projects"
                ><span class="relative z-10">Projects</span>
                <div
                  class="absolute inset-0 bg-gradient-to-r from-[#7AC5FF]/20 to-[#0061ae]/20 rounded-full"
                ></div
              ></a>
              <a
                href="index.html#details"
                class="nav-item group relative px-4 py-2.5 text-sm font-medium text-gray-600 hover:text-[#0061ae] transition-all duration-300 rounded-full"
                data-i18n="nav.services"
                ><span class="relative z-10">Services</span>
                <div
                  class="absolute inset-0 bg-[#0061ae]/5 rounded-full opacity-0 group-hover:opacity-100 transition-all"
                ></div
              ></a>
              <a
                href="index.html#about"
                class="nav-item group relative px-4 py-2.5 text-sm font-medium text-gray-600 hover:text-[#0061ae] transition-all duration-300 rounded-full"
                data-i18n="nav.about"
                ><span class="relative z-10">About</span>
                <div
                  class="absolute inset-0 bg-[#0061ae]/5 rounded-full opacity-0 group-hover:opacity-100 transition-all"
                ></div
              ></a>
              <a
                href="index.html#contact"
                class="nav-item group relative px-4 py-2.5 text-sm font-medium text-gray-600 hover:text-[#0061ae] transition-all duration-300 rounded-full"
                data-i18n="nav.contact"
                ><span class="relative z-10">Contact</span>
                <div
                  class="absolute inset-0 bg-[#0061ae]/5 rounded-full opacity-0 group-hover:opacity-100 transition-all"
                ></div
              ></a>
              <a
                href="/assets/cmms.html"
                class="nav-item group relative px-4 py-2.5 text-sm font-medium text-gray-600 hover:text-[#0061ae] transition-all duration-300 rounded-full"
                data-i18n="nav.cmms"
              >
                <span class="relative z-10 flex items-center gap-1.5"
                  ><span class="relative flex h-1.5 w-1.5"
                    ><span
                      class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#7AC5FF] opacity-75"
                    ></span
                    ><span
                      class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[#7AC5FF]"
                    ></span></span
                  >CMMS</span
                >
                <div
                  class="absolute inset-0 bg-[#0061ae]/5 rounded-full opacity-0 group-hover:opacity-100 transition-all"
                ></div>
              </a>
            </div>
          </div>

          <!-- Language toggle -->
          <div class="hidden md:flex items-center space-x-3">
            <span id="desktopIdText" class="text-gray-500 text-sm font-medium"
              >ID</span
            >
            <button
              id="languageToggle"
              class="relative w-14 h-7 bg-[#0061ae]/10 rounded-full border border-[#0061ae]/20 transition-all duration-300 focus:outline-none hover:bg-[#0061ae]/20"
            >
              <div
                id="toggleSlider"
                class="absolute top-0.5 left-0.5 w-6 h-6 bg-gradient-to-r from-[#7AC5FF] to-[#0F5F98] rounded-full shadow-lg transform transition-transform duration-300 flex items-center justify-center"
              >
                <svg
                  class="w-3 h-3 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                  />
                </svg>
              </div>
            </button>
            <span id="desktopEnText" class="text-gray-500 text-sm font-medium"
              >EN</span
            >
          </div>

          <!-- Mobile hamburger -->
          <div class="md:hidden flex items-center space-x-3">
            <div class="flex items-center space-x-2">
              <span id="mobileIdText" class="text-gray-500 text-xs font-medium"
                >ID</span
              >
              <button
                id="mobileLangToggle"
                class="relative w-10 h-5 bg-[#0061ae]/10 rounded-full border border-[#0061ae]/20 transition-all"
              >
                <div
                  id="mobileToggleSlider"
                  class="absolute top-0.5 left-0.5 w-4 h-4 bg-gradient-to-r from-[#7AC5FF] to-[#0F5F98] rounded-full transform transition-transform duration-300 flex items-center justify-center"
                >
                  <svg
                    class="w-2 h-2 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                    />
                  </svg>
                </div>
              </button>
              <span id="mobileEnText" class="text-gray-500 text-xs font-medium"
                >EN</span
              >
            </div>
            <button
              type="button"
              id="mobileMenuButton"
              class="mobile-menu-button relative w-10 h-10 text-gray-700 hover:bg-[#0061ae]/10 rounded-lg transition-all focus:outline-none"
              aria-controls="mobile-menu"
              aria-expanded="false"
            >
              <span class="sr-only">Open main menu</span>
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="hamburger-lines space-y-1">
                  <div
                    class="hamburger-line w-5 h-0.5 bg-current transition-all duration-300"
                  ></div>
                  <div
                    class="hamburger-line w-5 h-0.5 bg-current transition-all duration-300"
                  ></div>
                  <div
                    class="hamburger-line w-5 h-0.5 bg-current transition-all duration-300"
                  ></div>
                </div>
              </div>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile menu -->
      <div class="mobile-menu md:hidden hidden" id="mobile-menu">
        <div
          class="bg-white border-t border-gray-100 shadow-2xl px-4 py-6 space-y-1"
        >
          <a
            href="index.html#home"
            class="group flex items-center px-4 py-3 text-gray-700 hover:text-[#0061ae] hover:bg-[#0061ae]/5 rounded-xl transition-all"
            data-i18n="nav.home"
            ><div class="flex items-center space-x-3">
              <div
                class="w-2 h-2 bg-gradient-to-r from-[#7AC5FF] to-[#0F5F98] rounded-full opacity-40 group-hover:opacity-100 transition-opacity"
              ></div>
              <span class="font-medium">Home</span>
            </div></a
          >
          <a
            href="index.html#projects"
            class="group flex items-center px-4 py-3 text-[#0061ae] bg-[#0061ae]/5 rounded-xl transition-all"
            data-i18n="nav.projects"
            ><div class="flex items-center space-x-3">
              <div
                class="w-2 h-2 bg-gradient-to-r from-[#7AC5FF] to-[#0F5F98] rounded-full"
              ></div>
              <span class="font-semibold">Projects</span>
            </div></a
          >
          <a
            href="index.html#details"
            class="group flex items-center px-4 py-3 text-gray-600 hover:text-[#0061ae] hover:bg-[#0061ae]/5 rounded-xl transition-all"
            data-i18n="nav.services"
            ><div class="flex items-center space-x-3">
              <div
                class="w-2 h-2 bg-gradient-to-r from-[#7AC5FF] to-[#0F5F98] rounded-full opacity-40 group-hover:opacity-100 transition-opacity"
              ></div>
              <span class="font-medium">Services</span>
            </div></a
          >
          <a
            href="index.html#about"
            class="group flex items-center px-4 py-3 text-gray-600 hover:text-[#0061ae] hover:bg-[#0061ae]/5 rounded-xl transition-all"
            data-i18n="nav.about"
            ><div class="flex items-center space-x-3">
              <div
                class="w-2 h-2 bg-gradient-to-r from-[#7AC5FF] to-[#0F5F98] rounded-full opacity-40 group-hover:opacity-100 transition-opacity"
              ></div>
              <span class="font-medium">About</span>
            </div></a
          >
          <a
            href="index.html#contact"
            class="group flex items-center px-4 py-3 text-gray-600 hover:text-[#0061ae] hover:bg-[#0061ae]/5 rounded-xl transition-all"
            data-i18n="nav.contact"
            ><div class="flex items-center space-x-3">
              <div
                class="w-2 h-2 bg-gradient-to-r from-[#7AC5FF] to-[#0F5F98] rounded-full opacity-40 group-hover:opacity-100 transition-opacity"
              ></div>
              <span class="font-medium">Contact</span>
            </div></a
          >
          <div class="pt-2 mt-2 border-t border-gray-100">
            <a
              href="/assets/cmms.html"
              class="group flex items-center px-4 py-3 text-gray-700 hover:bg-[#0061ae]/5 rounded-xl transition-all"
              data-i18n="nav.cmms"
            >
              <div class="flex items-center space-x-3">
                <span class="relative flex h-2 w-2"
                  ><span
                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#7AC5FF] opacity-75"
                  ></span
                  ><span
                    class="relative inline-flex rounded-full h-2 w-2 bg-[#7AC5FF]"
                  ></span></span
                ><span class="font-semibold">CMMS</span
                ><span
                  class="ml-1 px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-gradient-to-r from-[#7AC5FF] to-[#0F5F98] text-white leading-none"
                  >App</span
                >
              </div>
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- ═══════════════════════════════════════════
         HERO
    ═══════════════════════════════════════════ -->
    <section class="hero-section font-montserrat">
      <!-- Blobs -->
      <div
        class="hero-blob top-20 left-10 w-20 h-20 bg-white/10 animate-bounce"
        style="animation-duration: 3s"
      ></div>
      <div
        class="hero-blob top-36 right-16 w-12 h-12 bg-yellow-300/20 rotate-45 animate-bounce"
        style="animation-delay: 1s; animation-duration: 4s"
      ></div>
      <div
        class="hero-blob bottom-24 left-24 w-14 h-14 bg-white/10 animate-bounce"
        style="animation-delay: 2s; animation-duration: 3.5s"
      ></div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <!-- Badge -->
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/20 border border-white/35 text-[11px] font-bold text-white tracking-[0.1em] uppercase mb-6 backdrop-blur-sm mx-auto"
        >
          <div class="w-[7px] h-[7px] rounded-full bg-[#7dffbd]"></div>
          <span>SUMBER SARANA SOLUSINDO · PORTOFOLIO</span>
        </div>

        <h1
          class="text-[clamp(32px,4.5vw,58px)] font-extrabold leading-[1.1] tracking-tight mb-5 text-white"
        >
          <span id="hero-title-main">Daftar</span>
          <span class="text-yellow-300" id="hero-title-highlight">
            Proyek &amp; Kontrak</span
          >
        </h1>

        <p
          class="text-base text-white/80 leading-[1.75] max-w-[560px] font-normal"
          id="hero-subtitle"
        >
          Dokumentasi menyeluruh seluruh kontrak pemeliharaan preventif,
          perbaikan korektif, dan proyek instalasi sistem mekanikal &amp;
          elektrikal.
        </p>
      </div>

      <!-- Stats strip -->
      <div
        class="grid grid-cols-2 md:grid-cols-4 bg-white rounded-[20px] overflow-hidden border border-gray-200 mt-12 max-w-3xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="150"
      >
        <div class="px-6 py-6 text-center border-r border-gray-200">
          <div class="stat-num">55+</div>
          <div
            class="text-[11px] font-semibold text-gray-400 uppercase tracking-[0.07em]"
            id="stat-pm"
          >
            Kontrak PM
          </div>
        </div>
        <div class="px-6 py-6 text-center border-r border-gray-200">
          <div class="stat-num">4</div>
          <div
            class="text-[11px] font-semibold text-gray-400 uppercase tracking-[0.07em]"
            id="stat-sites"
          >
            Lokasi Utama
          </div>
        </div>
        <div class="px-6 py-6 text-center border-r border-gray-200">
          <div class="stat-num">16+</div>
          <div
            class="text-[11px] font-semibold text-gray-400 uppercase tracking-[0.07em]"
            id="stat-evcs"
          >
            Proyek EVCS
          </div>
        </div>
        <div class="px-6 py-6 text-center">
          <div class="stat-num">2023</div>
          <div
            class="text-[11px] font-semibold text-gray-400 uppercase tracking-[0.07em]"
            id="stat-since"
          >
            Beroperasi Sejak
          </div>
        </div>
      </div>

      <!-- Wave -->
      <div class="absolute bottom-0 left-0 right-0 w-full">
        <svg
          viewBox="0 0 1200 120"
          class="block w-full fill-gray-50"
          preserveAspectRatio="none"
          style="height: 60px"
        >
          <path
            d="M0,120 C100,80 200,40 400,60 C600,80 800,40 1200,60 L1200,120 Z"
          />
        </svg>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SERVICE CATEGORIES SECTION
         Same cards as index.html ServicesSection.js
         but rendered inline here for projects.html
         (no JS dependency needed on this page).
    ═══════════════════════════════════════════ -->
    <section class="bg-white py-20 md:py-28 font-poppins overflow-hidden">
      <div class="container mx-auto px-6 md:px-12">
        <!-- Section header — same style as the other sections -->
        <div class="mb-14" data-aos="fade-up">
          <div
            class="section-badge-grad inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[11px] font-bold text-white tracking-[0.08em] uppercase mb-4"
          >
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
              />
            </svg>
            <span id="svc-section-badge">LAYANAN KAMI</span>
          </div>
          <h2
            class="text-[clamp(24px,3vw,38px)] font-extrabold tracking-tight leading-[1.15] mb-3 font-montserrat"
            style="color: #1d3d62"
          >
            <span id="svc-section-title">Kategori Layanan</span>
            <span class="text-gradient-blue" id="svc-section-highlight">
              yang Kami Kerjakan</span
            >
          </h2>
          <p
            class="text-[15px] text-gray-500 leading-[1.75] max-w-[560px] font-normal"
            id="svc-section-desc"
          >
            Seluruh kategori sistem mekanikal &amp; elektrikal yang kami rawat
            dan pasang di setiap gedung yang kami tangani.
          </p>
        </div>

        <!-- Cards grid — rendered by projectsSvcCards() below -->
        <div
          id="projectsSvcGrid"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 gap-x-8"
          data-aos="fade-up"
          data-aos-delay="80"
        >
          <!-- Injected by inline script -->
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         MAIN CONTENT
    ═══════════════════════════════════════════ -->
    <main class="bg-gray-50">
      <div class="max-w-6xl mx-auto px-5 md:px-10 py-20">
        <!-- ── SECTION 01: PREVENTIVE MAINTENANCE ── -->
        <section class="mb-4" data-aos="fade-up">
          <!-- Section header -->
          <div class="mb-14">
            <div
              class="section-badge-grad inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[11px] font-bold text-white tracking-[0.08em] uppercase mb-4"
            >
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span id="s1-num">SEKSI 01</span>
            </div>
            <h2
              class="text-[clamp(24px,3vw,38px)] font-extrabold text-[#0F5F98] tracking-tight leading-[1.15] mb-3 font-montserrat"
            >
              <span id="s1-title">Kontrak</span>
              <span
                class="bg-gradient-to-r from-[#7AC5FF] to-[#0F5F98] bg-clip-text text-transparent"
              >
                Pemeliharaan Preventif</span
              >
            </h2>
            <p
              class="text-[15px] text-gray-600 leading-[1.75] max-w-[580px] font-normal"
              id="s1-sub"
            >
              Seluruh kontrak pemeliharaan preventif rutin yang sedang berjalan,
              mencakup sistem mekanikal &amp; elektrikal di setiap gedung.
            </p>
          </div>

          <!-- Site groups rendered by JS -->
          <div id="pm-groups"></div>
        </section>

        <div class="section-divider"></div>

        <!-- ── SECTION 02: CORRECTIVE ── -->
        <section class="mb-4" data-aos="fade-up">
          <div class="mb-14">
            <div
              class="section-badge-grad inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[11px] font-bold text-white tracking-[0.08em] uppercase mb-4"
            >
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                />
                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span id="s2-num">SEKSI 02</span>
            </div>
            <h2
              class="text-[clamp(24px,3vw,38px)] font-extrabold text-[#0F5F98] tracking-tight leading-[1.15] mb-3 font-montserrat"
            >
              <span id="s2-title">Perbaikan Korektif</span>
              <span
                class="bg-gradient-to-r from-[#7AC5FF] to-[#0F5F98] bg-clip-text text-transparent"
              >
                &amp; Peningkatan Sistem</span
              >
            </h2>
            <p
              class="text-[15px] text-gray-600 leading-[1.75] max-w-[580px] font-normal"
              id="s2-sub"
            >
              Pekerjaan perbaikan, penggantian komponen, dan modernisasi sistem
              yang telah diselesaikan maupun sedang berjalan.
            </p>
          </div>
          <div class="flex flex-col gap-3" id="corrective-list"></div>
        </section>

        <div class="section-divider"></div>

        <!-- ── SECTION 03: INSTALLATION ── -->
        <section data-aos="fade-up">
          <div class="mb-14">
            <div
              class="section-badge-grad inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[11px] font-bold text-white tracking-[0.08em] uppercase mb-4"
            >
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              <span id="s3-num">SEKSI 03</span>
            </div>
            <h2
              class="text-[clamp(24px,3vw,38px)] font-extrabold text-[#0F5F98] tracking-tight leading-[1.15] mb-3 font-montserrat"
            >
              <span id="s3-title">Proyek Pemasangan</span>
              <span
                class="bg-gradient-to-r from-[#7AC5FF] to-[#0F5F98] bg-clip-text text-transparent"
              >
                &amp; Instalasi</span
              >
            </h2>
            <p
