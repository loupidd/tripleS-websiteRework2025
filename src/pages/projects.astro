          title_en: "EVCS Installation",
          loc: "GOP 9, BSD",
        },
        {
          kw: "66 KW",
          year: "2024",
          title_id: "Pemasangan EVCS",
          title_en: "EVCS Installation",
          loc: "GOP 1, BSD",
        },
        {
          kw: "60 KW",
          year: "2024",
          title_id: "Pemasangan EVCS",
          title_en: "EVCS Installation",
          loc: "Menara Imperium, Jakarta",
        },
        {
          kw: "104 KW",
          year: "2024",
          title_id: "Pemasangan EVCS",
          title_en: "EVCS Installation",
          loc: "MSIG Tower, Sudirman, Jakarta",
        },
        {
          kw: "ACS",
          year: "2024",
          title_id: "Penggantian Sistem Elevator Access Control — Merk Pegasus",
          title_en: "Elevator Access Control Replacement — Pegasus",
          loc: "ITS Tower",
          purple: true,
        },
        {
          kw: "PDAM",
          year: "2025",
          title_id: "Penggantian Instalasi Pipa Air Bersih Supply PDAM",
          title_en: "Domestic Water Supply Piping Replacement — PDAM",
          loc: "ITS Tower",
          purple: true,
        },
      ];

      // ─── Render helpers ───────────────────────────────────────────────────
      function lang() {
        return localStorage.getItem("preferredLanguage") || "id";
      }
      function isEn() {
        return lang() === "en";
      }

      function pmCardHTML(item) {
        const label = isEn() ? item.label_en : item.label_id;
        return `
        <div class="pm-card">
          <div class="pm-icon">${ICONS[item.icon]}</div>
          <div>
            <div class="pm-name">${label}</div>
            <div class="pm-period"><span class="live-dot"></span>2023 – ${isEn() ? "present" : "sekarang"}</div>
          </div>
        </div>`;
      }

      function pmExtraCardHTML(item) {
        const label = isEn() ? item.label_en : item.label_id;
        const period = isEn() ? item.period_en : item.period_id;
        return `
        <div class="pm-card">
          <div class="pm-icon">${ICONS[item.icon]}</div>
          <div>
            <div class="pm-name">${label}</div>
            <div class="pm-period">${item.live ? `<span class="live-dot"></span>` : ""}${period}</div>
          </div>
        </div>`;
      }

      function renderPM() {
        const container = document.getElementById("pm-groups");
        if (!container) return;
        let html = "";

        PM_SITES.forEach((site) => {
          const siteName = isEn() ? site.name_en : site.name_id;
          const pillClass =
            site.status === "ongoing"
              ? "bg-green-50 text-green-700 border border-green-200"
              : "bg-amber-50 text-amber-700 border border-amber-200";
          const pillLabel =
            site.status === "ongoing"
              ? isEn()
                ? "Ongoing"
                : "Berjalan"
              : isEn()
                ? "Mixed"
                : "Aktif/Selesai";
          const dotColor =
            site.status === "ongoing" ? "bg-green-500" : "bg-amber-400";

          html += `
          <div class="mb-10" data-aos="fade-up">
            <div class="site-header">
              ${ICONS.bolt}
              <span class="font-bold text-[14px] text-slate-800">${siteName}</span>
              <span class="ml-auto flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold flex-shrink-0 ${pillClass}">
                <span class="w-1.5 h-1.5 rounded-full ${dotColor}"></span>${pillLabel}
              </span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
              ${PM_ITEMS.map(pmCardHTML).join("")}
            </div>
          </div>`;
        });

        // Extra site
        html += `
        <div class="mb-2" data-aos="fade-up">
          <div class="site-header">
            ${ICONS.bolt}
            <span class="font-bold text-[14px] text-slate-800">${isEn() ? "PT. Infokom Elektrindo & ITS Tower — Additional Services" : "PT. Infokom Elektrindo & ITS Tower — Layanan Tambahan"}</span>
            <span class="ml-auto flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200 flex-shrink-0">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>${isEn() ? "Active / Completed" : "Aktif / Selesai"}
            </span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            ${PM_EXTRA.map(pmExtraCardHTML).join("")}
          </div>
        </div>`;

        container.innerHTML = html;
      }

      function renderCorrective() {
        const el = document.getElementById("corrective-list");
        if (!el) return;
        el.innerHTML = CORRECTIVE.map(
          (c) => `
        <div class="list-card" data-aos="fade-up">
          <div class="year-badge">${c.year}</div>
          <div class="pm-icon flex-shrink-0">${ICONS[c.icon]}</div>
          <div class="flex-1 min-w-0">
            <div class="list-title">${isEn() ? c.title_en : c.title_id}</div>
            <div class="list-meta">${ICONS.location}${c.loc}</div>
          </div>
        </div>`,
        ).join("");
      }

      function renderInstalls() {
        const el = document.getElementById("install-list");
        if (!el) return;
        el.innerHTML = INSTALLS.map(
          (i) => `
        <div class="list-card" data-aos="fade-up">
          <div class="kw-badge ${i.purple ? "kw-badge-purple" : ""}">${i.kw}</div>
          <div class="pm-icon flex-shrink-0">${ICONS.bolt}</div>
          <div class="flex-1 min-w-0">
            <div class="list-title">${isEn() ? i.title_en : i.title_id}</div>
            <div class="list-meta flex gap-4 flex-wrap">
              <span class="flex items-center gap-1">${ICONS.location}${i.loc}</span>
              <span class="flex items-center gap-1">${ICONS.calendar}${i.year}</span>
            </div>
          </div>
        </div>`,
        ).join("");
      }

      function applyPageI18n() {
        const en = isEn();
        const set = (id, v) => {
          const el = document.getElementById(id);
          if (el) el.textContent = v;
        };
        // Service category section header
        set("svc-section-badge", en ? "OUR SERVICES" : "LAYANAN KAMI");
        set(
          "svc-section-title",
          en ? "Service Categories" : "Kategori Layanan",
        );
        set("svc-section-highlight", en ? " We Handle" : " yang Kami Kerjakan");
        set(
          "svc-section-desc",
          en
            ? "All mechanical & electrical system categories we maintain and install across every building we handle."
            : "Seluruh kategori sistem mekanikal & elektrikal yang kami rawat dan pasang di setiap gedung yang kami tangani.",
        );
        set("hero-title-main", en ? "Project & Contract" : "Daftar");
        set("hero-title-highlight", en ? " Track Record" : " Proyek & Kontrak");
        set(
          "hero-subtitle",
          en
            ? "Comprehensive documentation of all preventive maintenance contracts, corrective repairs, and mechanical & electrical system installations."
            : "Dokumentasi menyeluruh seluruh kontrak pemeliharaan preventif, perbaikan korektif, dan proyek instalasi sistem mekanikal & elektrikal.",
        );
        set("stat-pm", en ? "PM Contracts" : "Kontrak PM");
        set("stat-sites", en ? "Key Sites" : "Lokasi Utama");
        set("stat-evcs", en ? "EVCS Projects" : "Proyek EVCS");
        set("stat-since", en ? "Operating Since" : "Beroperasi Sejak");
        set("s1-num", en ? "SECTION 01" : "SEKSI 01");
        set("s1-title", en ? "Preventive Maintenance" : "Kontrak");
        set(
          "s1-sub",
          en
            ? "All ongoing preventive maintenance contracts covering mechanical & electrical systems at every building site."
            : "Seluruh kontrak pemeliharaan preventif rutin yang sedang berjalan, mencakup sistem mekanikal & elektrikal di setiap gedung.",
        );
        set("s2-num", en ? "SECTION 02" : "SEKSI 02");
        set("s2-title", en ? "Corrective Repairs" : "Perbaikan Korektif");
        set(
          "s2-sub",
          en
            ? "Component replacements, system repairs, and modernization works — completed and in progress."
            : "Pekerjaan perbaikan, penggantian komponen, dan modernisasi sistem yang telah diselesaikan maupun sedang berjalan.",
        );
        set("s3-num", en ? "SECTION 03" : "SEKSI 03");
        set("s3-title", en ? "Installation Projects" : "Proyek Pemasangan");
        set(
          "s3-sub",
          en
            ? "All Electric Vehicle Charging Station (EVCS) installation projects and other system installations."
            : "Seluruh proyek pemasangan Electric Vehicle Charging Station (EVCS) dan instalasi sistem lainnya.",
        );
      }

      function renderAll() {
        applyPageI18n();
        // Service category cards — rendered via ServicesSection.js
        // Uses projectsSvcGrid (not servicesGrid) so it doesn't
        // clash with index.html's instance.
        if (window._projectsSvc) window._projectsSvc._render();
        renderPM();
        renderCorrective();
        renderInstalls();
      }

      // ─── Init ─────────────────────────────────────────────────────────────
      document.addEventListener("DOMContentLoaded", function () {
        AOS.init({
          duration: 550,
          easing: "ease-out-cubic",
          once: true,
          offset: 40,
        });

        const navbar = document.getElementById("navbar");
        if (navbar) {
          window.addEventListener(
            "scroll",
            () => {
              navbar.classList.toggle("scrolled", window.scrollY > 30);
            },
            { passive: true },
          );
        }

        // Instantiate ServicesSection targeting the projects page grid
        if (typeof ServicesSection !== "undefined") {
          const i18nShim = {
            get lang() {
              return localStorage.getItem("preferredLanguage") || "id";
            },
            t(key) {
              const lang = localStorage.getItem("preferredLanguage") || "id";
              const data =
                window.i18nData?.[lang] ?? window.i18nData?.["id"] ?? {};
              return key.split(".").reduce((o, k) => o?.[k], data) ?? key;
            },
          };
          window._projectsSvc = new ServicesSection({
            i18n: i18nShim,
            animations: null,
            gridId: "projectsSvcGrid",
            btnId: null, // no portfolio CTA button on this page
          });
        }

        renderAll();

        // Re-render on language change (dispatched by navbar.js)
        document.addEventListener("languageChanged", function () {
          renderAll();
          if (typeof AOS !== "undefined") AOS.refresh();
        });
      });
    </script>
</BaseLayout>
